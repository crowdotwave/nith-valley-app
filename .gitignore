node_modules/
dist/
dist-ssr/
*.local

.env
.env.*
!.env.example

# The native projects under android/ and ios/ are committed: they carry the
# link scheme, permission strings and icons, which are hand-edited and cannot be
# regenerated. Each has its own .gitignore for build output and the copy of
# dist/ that `npx cap sync` puts inside it.

.DS_Store
Thumbs.db
*.log
.vscode/*
!.vscode/extensions.json

# Impeccable tooling install (machine-local; restore with `npx impeccable install`).
# The design context it produces, .impeccable/, is committed.
.claude/

# Demo pet photographs. Deliberately not committed and deliberately not in
# public/: the pet-photos bucket is private precisely so a client's photo is
# never left on a permanent public URL, and anything in public/ ships in every
# deploy. These are staged here only to be uploaded through the app.
demo-photos/
